# Whitelist: nothing from the game may be committed. Everything is ignored unless listed here.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/FINDINGS.md
!/names.tsv
!/rtti_classes.txt
!/vtables.txt
!/ghidra_funcs.tsv
!/docs/
!/symbols/
!/tools/
!/patches/
!/ghidra/
/ghidra/*
!/ghidra/scripts/
__pycache__/
*.pickle
*.pyc
.DS_Store

# Community automation and contributor templates only.
!/.github/
/.github/*
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/
/.github/workflows/*
!/.github/workflows/tools.yml
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/research.md
!/.github/ISSUE_TEMPLATE/runtime-bug.md
